#!/usr/bin/env bash
#
# build - build a snap from this monorepo.
#
#   ./build --list
#   ./build <snap> [--keep] [--dry-run] [--workspace DIR] [-- <snapcraft args>]
#
# Builds happen out of tree so the repository stays clean.

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
RECIPES="$ROOT/recipes"
DEFAULT_WORKSPACE="${SNAPS_BUILD_DIR:-/var/tmp/opencode/snaps-build}"

die() {
    printf 'build: error: %s\n' "$*" >&2
    exit 1
}

info() {
    printf 'build: %s\n' "$*" >&2
}

usage() {
    cat <<'EOF'
Usage: ./build [options] <snap>[:<track>]

Build a snap from recipes/<snap> (e.g. gnome-logs). Builds run out of tree
in a temporary workspace.

A package with a single recipe is flat and implicitly builds the stable
track. A package with more than one track keeps its recipes under stable/,
beta/, edge/ (and optionally candidate/); <snap> then defaults to stable.

Options:
  --list               list packages and tracks, then exit
  --track TRACK        track to build: stable (default), candidate, beta, edge
  --keep               keep the workspace after a successful build
  --dry-run            print the resolved build plan and exit
  --workspace DIR      workspace root (default: $SNAPS_BUILD_DIR or
                       /var/tmp/opencode/snaps-build)
  --                   pass the remaining arguments to snapcraft
  -h, --help           show this help

Environment:
  SNAPS_BUILD_DIR      default workspace root

Examples:
  ./build --list
  ./build gnome-logs
  ./build ardour --track edge
  ./build ardour/edge
  ./build gnome-calculator --dry-run
  ./build gnome-calculator -- --build-for=arm64
EOF
}

# meta_get <pkgdir> <key>: print a scalar from metadata.yaml (keys may be
# dotted, e.g. store.publisher). Prints nothing when absent.
meta_get() {
    python3 - "$1/metadata.yaml" "$2" <<'PY'
import sys
import yaml

path, key = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as handle:
    value = yaml.safe_load(handle) or {}
for part in key.split("."):
    if not isinstance(value, dict) or part not in value:
        sys.exit(0)
    value = value[part]
if value is None:
    sys.exit(0)
if isinstance(value, bool):
    print("true" if value else "false")
elif isinstance(value, list):
    print(" ".join(str(item) for item in value))
else:
    print(value)
PY
}

# recipe_exists <dir>: true when <dir> holds a snapcraft recipe, in either
# of the two layouts used in this repository (snapcraft.yaml at the root of
# the build project, or snap/snapcraft.yaml).
recipe_exists() {
    [[ -f "$1/snapcraft.yaml" || -f "$1/snap/snapcraft.yaml" ]]
}

# tracks_in <pkgdir>: print the tracks available for a package, one per line.
# A flat package has only the implicit stable track.
tracks_in() {
    local pkgdir=$1 track
    if recipe_exists "$pkgdir"; then
        printf 'stable\n'
        return
    fi
    # A nested package without stable/ is invalid; keep it out of --list so
    # the layout error is reported by the build, with the package named.
    recipe_exists "$pkgdir/stable" || return 0
    for track in stable candidate beta edge; do
        [[ -d "$pkgdir/$track" ]] && recipe_exists "$pkgdir/$track" &&
            printf '%s\n' "$track"
    done
}

list_packages() {
    local manifest pkgdir name track base publisher row
    local name_width=4 track_width=5 base_width=4
    local -a rows=()

    while IFS= read -r manifest; do
        pkgdir="$(dirname -- "$manifest")"
        name="$(basename -- "$pkgdir")"
        if ((${#name} > name_width)); then
            name_width=${#name}
        fi
        base="$(meta_get "$pkgdir" base)"
        if ((${#base} > base_width)); then
            base_width=${#base}
        fi
        while IFS= read -r track; do
            if ((${#track} > track_width)); then
                track_width=${#track}
            fi
            publisher="$(meta_get "$pkgdir" store.publisher)"
            rows+=("$name"$'\t'"$track"$'\t'"$base"$'\t'"$publisher")
        done < <(tracks_in "$pkgdir")
    done < <(find "$RECIPES" -mindepth 2 -maxdepth 2 -name metadata.yaml | sort)

    printf "%-${name_width}s  %-${track_width}s  %-${base_width}s  %s\n" \
        NAME TRACK BASE PUBLISHER
    for row in "${rows[@]}"; do
        IFS=$'\t' read -r name track base publisher <<< "$row"
        printf "%-${name_width}s  %-${track_width}s  %-${base_width}s  %s\n" \
            "$name" "$track" "$base" "$publisher"
    done
}

name=""
track=""
keep=0
dry_run=0
workspace="$DEFAULT_WORKSPACE"
snapcraft_args=()

while (($#)); do
    case "$1" in
        --list)
            list_packages
            exit 0
            ;;
        --keep)
            keep=1
            ;;
        --dry-run)
            dry_run=1
            ;;
        --track)
            (($# >= 2)) || die "--track requires a track name"
            track="$2"
            shift
            ;;
        --track=*)
            track="${1#*=}"
            ;;
        --workspace)
            (($# >= 2)) || die "--workspace requires a directory"
            workspace="$2"
            shift
            ;;
        --workspace=*)
            workspace="${1#*=}"
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --)
            shift
            snapcraft_args=("$@")
            break
            ;;
        -*)
            die "unknown option: $1 (try --help)"
            ;;
        *)
            [[ -z "$name" ]] || die "only one snap may be given (got '$name' and '$1')"
            name="$1"
            ;;
    esac
    shift
done

[[ -n "$name" ]] || {
    usage >&2
    exit 1
}

# Accept a snap name, a package directory, a track directory, a path to a
# recipe, or a "snap:track" / "snap/track" pair.
raw_name="$name"
name="${name#./}"
name="${name%/}"

if [[ "$name" == *:* ]]; then
    [[ -z "$track" ]] || die "track given twice (--track and ':${name##*:}')"
    track="${name##*:}"
    name="${name%:*}"
fi

# Resolve a snap name under recipes/, while still accepting an explicit
# path such as recipes/<snap> or an absolute path.
resolve_path() {
    local path=$1
    if [[ "$path" == /* ]]; then
        printf '%s\n' "$path"
    elif [[ -e "$ROOT/$path" ]]; then
        printf '%s\n' "$ROOT/$path"
    else
        printf '%s\n' "$RECIPES/$path"
    fi
}

candidate="$(resolve_path "$name")"

# A flat package has no stable/ directory, but "pkg/stable" should still
# resolve to it: the track is implicit, the path is only a selector.
if [[ ! -e "$candidate" && "$name" == */* ]]; then
    parent="${name%/*}"
    last="${name##*/}"
    case "$last" in
        stable | candidate | beta | edge)
            parent_candidate="$(resolve_path "$parent")"
            if [[ -d "$parent_candidate" ]]; then
                [[ -z "$track" || "$track" == "$last" ]] ||
                    die "track '$track' does not match '$raw_name'"
                track="$last"
                candidate="$parent_candidate"
            fi
            ;;
    esac
fi

[[ -e "$candidate" ]] || die "no such snap: $raw_name; try ./build --list"

# The metadata stays at the package root, above any track directory.
pkgdir="$candidate"
while [[ ! -f "$pkgdir/metadata.yaml" && "$pkgdir" != "$ROOT" && "$pkgdir" != "/" ]]; do
    pkgdir="$(dirname -- "$pkgdir")"
done
[[ -f "$pkgdir/metadata.yaml" ]] || die "no metadata.yaml above $candidate"

name="$(basename -- "$pkgdir")"

# A trailing path component inside the package is a track: pkg/edge.
if [[ "$candidate" != "$pkgdir" ]]; then
    rel="${candidate#"$pkgdir"/}"
    pathtrack="${rel%%/*}"
    case "$pathtrack" in
        stable | candidate | beta | edge)
            [[ -z "$track" || "$track" == "$pathtrack" ]] ||
                die "track '$track' does not match '$candidate'"
            track="$pathtrack"
            ;;
        *)
            die "unrecognised track '$pathtrack' in $candidate"
            ;;
    esac
fi

track="${track:-stable}"
case "$track" in
    stable | candidate | beta | edge) ;;
    *) die "invalid track '$track' (expected stable, candidate, beta or edge)" ;;
esac

# Flat and nested layouts must not be mixed. A flat package is implicitly
# stable; a nested package has stable/ plus one or more extra tracks.
recipe_root=""
if recipe_exists "$pkgdir"; then
    for other in stable candidate beta edge; do
        [[ -d "$pkgdir/$other" ]] && recipe_exists "$pkgdir/$other" &&
            die "$name mixes a flat recipe with a nested '$other/' recipe"
    done
    [[ "$track" == stable ]] ||
        die "$name is a flat package and only has the implicit stable track"
    recipe_root="$pkgdir"
elif [[ -d "$pkgdir/$track" ]] && recipe_exists "$pkgdir/$track"; then
    recipe_exists "$pkgdir/stable" ||
        die "nested package $name must also carry a stable/ recipe"
    recipe_root="$pkgdir/$track"
else
    die "no '$track' recipe for $name; try ./build --list"
fi

snap="$(meta_get "$pkgdir" snap)"
mode="$(meta_get "$pkgdir" mode)"
base="$(meta_get "$pkgdir" base)"
overlay_repo="$(meta_get "$pkgdir" overlay-repo)"
overlay_commit="$(meta_get "$pkgdir" overlay-commit)"
overlay_to="$(meta_get "$pkgdir" overlay-to)"
prepare="$(meta_get "$pkgdir" prepare)"

[[ -n "$snap" ]] || die "metadata.yaml is missing 'snap'"
[[ "$snap" == "$name" ]] || die "metadata snap '$snap' does not match directory '$name'"

case "$mode" in
    vendored | overlay) ;;
    *) die "metadata.yaml has invalid mode '$mode' (expected vendored or overlay)" ;;
esac

if [[ "$mode" == overlay ]]; then
    [[ -n "$overlay_repo" ]] || die "overlay mode requires 'overlay-repo'"
    overlay_to="${overlay_to:-snap}"
    [[ "$overlay_to" != /* && "$overlay_to" != *..* ]] ||
        die "invalid overlay-to '$overlay_to'"
fi

if [[ "$recipe_root" == "$pkgdir" ]]; then
    ws="$workspace/$name"
else
    ws="$workspace/$name-$track"
fi

if ((dry_run)); then
    printf 'snap:       %s\n' "$snap"
    printf 'package:    %s\n' "${pkgdir#"$ROOT"/}"
    printf 'track:      %s%s\n' "$track" \
        "$([[ "$recipe_root" == "$pkgdir" ]] && printf ' (flat, implicit)')"
    printf 'recipe:     %s\n' "${recipe_root#"$ROOT"/}"
    printf 'base:       %s\n' "$base"
    printf 'mode:       %s\n' "$mode"
    printf 'workspace:  %s\n' "$ws"
    if [[ "$mode" == overlay ]]; then
        printf 'overlay:    %s at %s -> %s/\n' \
            "$overlay_repo" "${overlay_commit:-default branch}" "$overlay_to"
    fi
    [[ -z "$prepare" ]] || printf 'prepare:    %s\n' "$prepare"
    printf 'snapcraft:  snapcraft pack --use-lxd'
    ((${#snapcraft_args[@]})) && printf ' %s' "${snapcraft_args[@]}"
    printf '\n'
    exit 0
fi

for cmd in git python3 rsync snapcraft; do
    command -v "$cmd" >/dev/null 2>&1 || die "missing dependency: $cmd"
done
python3 -c 'import yaml' >/dev/null 2>&1 || die "python3 is missing PyYAML"

mkdir -p -- "$workspace"

rm -rf -- "$ws"
mkdir -p -- "$ws"

cleanup() {
    local status=$?
    if ((status != 0)); then
        info "build failed; workspace kept: $ws"
    elif ((!keep)); then
        rm -rf -- "$ws"
    else
        info "workspace kept: $ws"
    fi
    exit "$status"
}
trap cleanup EXIT

case "$mode" in
    vendored)
        info "copying ${recipe_root#"$ROOT"/} into $ws"
        rsync -a --exclude=metadata.yaml --exclude=.git -- "$recipe_root/" "$ws/"
        ;;
    overlay)
        info "cloning $overlay_repo${overlay_commit:+ at $overlay_commit}"
        if [[ -n "$overlay_commit" ]]; then
            git clone --quiet --filter=blob:none --no-checkout -- "$overlay_repo" "$ws" ||
                git clone --quiet --no-checkout -- "$overlay_repo" "$ws"
            git -C "$ws" checkout --quiet --detach "$overlay_commit"
        else
            git clone --quiet --depth=1 -- "$overlay_repo" "$ws"
        fi
        info "overlaying ${recipe_root#"$ROOT"/}/snap/ onto $overlay_to/"
        mkdir -p -- "$ws/$overlay_to"
        rsync -a -- "$recipe_root/snap/" "$ws/$overlay_to/"
        ;;
esac

if [[ -n "$prepare" ]]; then
    info "prepare: $prepare"
    (cd "$ws" && bash -c "$prepare")
fi

info "building $snap ($track) with snapcraft pack --use-lxd"
(cd "$ws" && snapcraft pack --use-lxd "${snapcraft_args[@]+"${snapcraft_args[@]}"}")

artifact=""
while IFS= read -r candidate; do
    artifact="$candidate"
done < <(find "$ws" -maxdepth 1 -type f -name '*.snap' -printf '%T@ %p\n' | sort -n | cut -d' ' -f2-)

if [[ -n "$artifact" ]]; then
    if ((!keep)); then
        # The workspace is removed on success; keep the artifact outside it.
        mkdir -p -- "$workspace/artifacts"
        final="$workspace/artifacts/$(basename -- "$artifact")"
        mv -f -- "$artifact" "$final"
    else
        final="$artifact"
    fi
    info "built $final ($(du -h -- "$final" | cut -f1))"
    printf '%s\n' "$final"
else
    info "snapcraft finished but no .snap was found in $ws"
fi
