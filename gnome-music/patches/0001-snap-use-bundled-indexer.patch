@@ -31,6 +34,38 @@ from gnomemusic.widgets.preferencesdialog import PreferencesDialog
 from gnomemusic.window import Window
 
 
+_INDEXER_PROCESS = None
+
+
+def _start_bundled_indexer() -> None:
+    """Start the TinySPARQL indexer bundled in the snap.
+
+    A strictly confined snap cannot reach the indexer running in the host
+    session, and the session bus cannot activate the bundled copy because its
+    service file is not in the host's XDG data directories. Launch it
+    directly and wait until it owns the bus name the Tracker wrapper uses.
+    """
+    global _INDEXER_PROCESS
+
+    if _INDEXER_PROCESS is not None:
+        return
+
+    indexer = os.path.join(os.environ["SNAP"], "usr/libexec/localsearch-3")
+    _INDEXER_PROCESS = subprocess.Popen([indexer])
+
+    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
+    name = "org.gnome.Music.Tracker3.Miner.Files"
+    for _attempt in range(30):
+        result = bus.call_sync(
+            "org.freedesktop.DBus", "/org/freedesktop/DBus",
+            "org.freedesktop.DBus", "NameHasOwner",
+            GLib.Variant("(s)", (name,)), None,
+            Gio.DBusCallFlags.NONE, -1, None)
+        if result.unpack()[0]:
+            return
+        time.sleep(0.1)
+
+
 class Application(Adw.Application):
 
     def __init__(self, application_id, version):
