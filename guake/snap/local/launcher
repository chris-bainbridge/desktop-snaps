#!/bin/sh
# Guake is a Python 3 + GTK 3 + VTE application. The GNOME platform snap
# provides the interpreter, PyGObject, pycairo, dbus-python and the GTK 3,
# VTE, libnotify and AppIndicator typelibs; PyYAML, Keybinder 3 and libwnck 3
# are staged inside this snap.
export PYTHONPATH="$SNAP/usr/lib/python3/dist-packages${PYTHONPATH:+:$PYTHONPATH}"
# The staged Keybinder/Wnck typelibs live under $SNAP/usr/lib/girepository-1.0,
# which is not on the platform interpreter's default search path.
export GI_TYPELIB_PATH="$SNAP/usr/lib/girepository-1.0${SNAP_LAUNCHER_ARCH_TRIPLET:+:$SNAP/usr/lib/$SNAP_LAUNCHER_ARCH_TRIPLET/girepository-1.0}${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"

exec "$SNAP/gnome-platform/usr/bin/python3" "$SNAP/usr/bin/guake" "$@"
