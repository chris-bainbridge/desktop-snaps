#!/bin/sh
# Launcher for the Heroic Games Launcher snap.
#
# This runs after the gnome extension's desktop-launch command-chain, which
# exports XDG_CONFIG_HOME=$SNAP_USER_DATA/.config and XDG_DATA_HOME=
# $SNAP_USER_DATA/.local/share. Heroic stores its configuration, its
# downloaded Wine/Proton builds, DXVK, winetricks and the store helpers in
# appData, i.e. below XDG_CONFIG_HOME. SNAP_USER_DATA is revision-specific and
# snapd copies it on every refresh, so a multi-gigabyte tools tree would be
# duplicated at each update. Move the data to SNAP_USER_COMMON and override
# the XDG variables after desktop-launch has done its own setup.
set -eu

export HOME="$SNAP_USER_COMMON"
export XDG_CONFIG_HOME="$SNAP_USER_COMMON/.config"
export XDG_DATA_HOME="$SNAP_USER_COMMON/.local/share"
export XDG_CACHE_HOME="$SNAP_USER_COMMON/.cache"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME"

# Chromium's setuid sandbox helper is not shipped (see snapcraft.yaml) and
# AppArmor does not grant this strict snap unprivileged user namespaces, so
# the internal sandbox cannot start. The snap's own confinement is the
# boundary; keep --no-sandbox in front of the user's arguments.
exec "$SNAP/opt/Heroic/heroic" --no-sandbox "$@"
