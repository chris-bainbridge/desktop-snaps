#!/bin/sh
# MyPaint is a Python 3 + GTK 3 application. The GNOME platform snap that the
# gnome extension mounts at $SNAP/gnome-platform provides the Python 3.14
# interpreter, PyGObject, pycairo and the GTK 3 typelibs. numpy, libmypaint and
# the brush collection are staged inside this snap.
export PYTHONPATH="$SNAP/usr/lib/python3/dist-packages${PYTHONPATH:+:$PYTHONPATH}"

# The platform's desktop-launch command-chain already points XDG_CONFIG_HOME,
# XDG_DATA_HOME and XDG_CACHE_HOME at the snap's private per-user areas (the
# "home" interface does not allow writing to ~/.config or ~/.local/share), so
# MyPaint's settings and brushes stay inside the snap. HOME is still set to
# $SNAP_USER_DATA by snapd; use the real home instead so that GTK's file
# chooser starts in the user's own files rather than in the snap's data
# directory. The "home" interface is what actually grants access to them.
export HOME="${SNAP_REAL_HOME:-$HOME}"

exec "$SNAP/gnome-platform/usr/bin/python3" "$SNAP/usr/bin/mypaint" "$@"
