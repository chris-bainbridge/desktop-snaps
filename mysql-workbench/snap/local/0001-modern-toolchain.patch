# Compatibility fixes for MySQL Workbench 8.0.47 on core26 / Ubuntu 26.04.
#
# - CMakeLists.txt: do not turn GCC 15 warnings into errors, and build with
#   -fsigned-char. MySQL's bundled parser assumes signed char; arm64 makes
#   char unsigned by default and fails to compile ctype-utf8.cpp otherwise.
# - library/forms/swig: replace the Python 2 C API calls (PyString_*,
#   PyInt_*, SWIG_Python_AppendOutput) that SWIG 4 pastes into the generated
#   mforms/cairo wrappers. This is required for Python 3 and SWIG 4.
# - plugins/wb.admin/backend/wb_server_management.py: pipes was removed in
#   Python 3.13; use shlex.quote. Without this the server management plugin
#   fails to import at startup.
# - res/scripts/python/grt_python_debugger.py: imp was removed in Python
#   3.12; use importlib.reload for the debugger's module reload.
# - library/grt/src/grt.h: drop the constructor template-id that is
#   ill-formed (a warning in C++17, an error in C++20).
# - backend/wbprivate/workbench/wb_context.cpp: suppress the unsupported-OS
#   warning, which would otherwise appear on every start because the snap's
#   /etc/os-release reports Ubuntu Core, not a name in Workbench's list.
#
# The Python/SWIG, C++20 and unsupported-OS hunks are adapted from Arch
# Linux's mysql-workbench 8.0.47-5 package (patches 0002, 0004, 0006 and
# 0008), the only distribution still building this release.
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3dd3e19..bfe2408 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -217,8 +217,11 @@ if(BUILD_FOR_GCOV)
     set(WB_CXXFLAGS ${WB_CXXFLAGS} -fprofile-arcs -ftest-coverage )
     set(WB_CFLAGS ${WB_CFLAGS} -fprofile-arcs -ftest-coverage)
 else()
-    set(WB_CXXFLAGS ${WB_CXXFLAGS} -Werror -Wno-nonnull)
-    set(WB_CFLAGS ${WB_CFLAGS} -Werror)
+    # Keep the warnings, but do not turn them into build failures: GCC 15 and
+    # the 26.04 headers warn about constructs that were quiet when this 8.0
+    # branch was written.
+    set(WB_CXXFLAGS ${WB_CXXFLAGS} -Wno-nonnull -fsigned-char)
+    set(WB_CFLAGS ${WB_CFLAGS} -fsigned-char)
 endif()
 
 #-----------------------------------------------------------------------
