#!/bin/bash
#
# Snap launcher for MySQL Workbench.
#
# Replaces the launcher generated by upstream's CMake build. That launcher
# probes the build host with ldconfig/ldd, preloads libraries, and exports
# absolute /usr/... paths, none of which work inside a strictly confined
# snap. This one only sets the paths Workbench looks up from the environment
# and then execs the real binary.
#
# The MWB_* variables are the ones upstream's mysql-workbench.in sets:
# data files, GRT Python modules, plugins, libraries and the binary dir.

set -e

export PATH="$SNAP/usr/bin:$SNAP/usr/sbin${PATH:+:$PATH}"

# Workbench's own shared libraries and loadable plugins. The GNOME
# extension's command chain has already added $SNAP/usr/lib/$arch and the
# platform paths to LD_LIBRARY_PATH.
export LD_LIBRARY_PATH="$SNAP/usr/lib/mysql-workbench:$SNAP/usr/lib/mysql-workbench/plugins${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# mforms/cairo and the wb Python helpers. MWB_MODULE_DIR is also added to
# sys.path by the GRT Python module loader.
export PYTHONPATH="$SNAP/usr/lib/mysql-workbench:$SNAP/usr/lib/mysql-workbench/modules${PYTHONPATH:+:$PYTHONPATH}"

export MWB_DATA_DIR="$SNAP/usr/share/mysql-workbench"
export MWB_LIBRARY_DIR="$SNAP/usr/share/mysql-workbench/libraries"
export MWB_MODULE_DIR="$SNAP/usr/lib/mysql-workbench/modules"
export MWB_PLUGIN_DIR="$SNAP/usr/lib/mysql-workbench/plugins"
export MWB_BASE_DIR="$SNAP/usr"
export MWB_BINARIES_DIR="$SNAP/usr/bin"
export DBC_DRIVER_PATH="$SNAP/usr/lib/mysql-workbench"

# GDAL and PROJ are staged in the snap; without these they look in the
# sandbox's /usr/share, which does not contain the data packages.
export GDAL_DATA="$SNAP/usr/share/gdal"
export PROJ_DATA="$SNAP/usr/share/proj"

# GDAL's compiled-in plugin directory is /usr/lib/<triplet>/gdalplugins,
# which resolves to the base filesystem inside the snap. Point it at the
# staged copy so drivers packaged separately from libgdal are found.
for gdal_plugins in "$SNAP"/usr/lib/*-linux-gnu/gdalplugins; do
  if [ -d "$gdal_plugins" ]; then
    export GDAL_DRIVER_PATH="$gdal_plugins"
    break
  fi
done

# The canvas and several custom widgets use X11-only GDK calls. Upstream
# also forces the X11 backend; on Wayland desktops this runs through
# XWayland, which the GNOME extension provides.
export GDK_BACKEND=x11

exec "$SNAP/usr/bin/mysql-workbench-bin" "$@"
