#!/bin/sh
# Hamster is a Python 3 + GTK 3 application. The gnome extension mounts the
# platform at $SNAP/gnome-platform; it provides the interpreter, PyGObject,
# pycairo, dbus-python and the GTK 3 typelibs. Hamster's own modules are
# installed in the snap's dist-packages, which is not on the platform
# interpreter's sys.path.
set -e

export PYTHONPATH="$SNAP/usr/lib/python3/dist-packages${PYTHONPATH:+:$PYTHONPATH}"

# snapd sets HOME to $SNAP_USER_DATA. The report folder chooser should start
# in the user's own home instead; the home interface grants access to it.
# XDG_DATA_HOME stays redirected to the snap's private area by the gnome
# extension's desktop-launch, so the database remains private.
export HOME="${SNAP_REAL_HOME:-$HOME}"

exec "$SNAP/gnome-platform/usr/bin/python3" "$SNAP/usr/bin/hamster" "$@"
