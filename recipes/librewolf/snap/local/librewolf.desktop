[Desktop Entry]
Version=1.0
Type=Application
Name=LibreWolf
GenericName=Web Browser
Comment=Browse the web with LibreWolf, a privacy-focused Firefox fork
Exec=librewolf %u
Icon=${SNAP}/meta/gui/librewolf.png
Terminal=false
Categories=Network;WebBrowser;
Keywords=web;browser;internet;privacy;firefox;
MimeType=text/html;text/xml;application/xhtml+xml;application/xml;application/pdf;application/rss+xml;application/rdf+xml;application/x-xpinstall;image/gif;image/jpeg;image/png;image/svg+xml;image/webp;audio/ogg;audio/webm;video/ogg;video/webm;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/chrome;
StartupNotify=true
StartupWMClass=librewolf
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=librewolf --new-window %u

[Desktop Action new-private-window]
Name=New Private Window
Exec=librewolf --private-window %u
