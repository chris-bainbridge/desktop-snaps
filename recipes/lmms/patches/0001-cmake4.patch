Description: configure with CMake 4
 LMMS 1.2.2 was released before CMake 4. CMake 4.2 refuses to set the OLD
 behaviour of CMP0026 (the LOCATION target property) and CMP0050 (the
 add_custom_command SOURCE signature), and it also rejects
 cmake_minimum_required(VERSION 2.8.7) unless a policy version floor is
 given. The floor is supplied with -DCMAKE_POLICY_VERSION_MINIMUM=3.5 in
 snapcraft.yaml; this patch drops the two unsupported policy settings and
 replaces the only non-imported LOCATION lookup (the bin2res helper) with
 the $<TARGET_FILE:...> generator expression used by the custom commands.
 LMMS does not use the add_custom_command SOURCE signature, so CMP0050 can
 simply keep its NEW default.
Forwarded: not-needed
Last-Update: 2026-11-17
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -8,9 +8,7 @@
 	CMAKE_POLICY(SET CMP0005 NEW)
 	CMAKE_POLICY(SET CMP0003 NEW)
 	IF (CMAKE_MAJOR_VERSION GREATER 2)
-		CMAKE_POLICY(SET CMP0026 OLD)
 		CMAKE_POLICY(SET CMP0045 NEW)
-		CMAKE_POLICY(SET CMP0050 OLD)
 	ENDIF()
 ENDIF(COMMAND CMAKE_POLICY)
 
@@ -539,7 +537,7 @@
 	ADD_CUSTOM_TARGET(bin2res COMMAND g++ "\"${BIN2RES_CPP}\"" -o "\"${BIN2RES}\"" DEPENDS "${BIN2RES_CPP}")
 ELSE(WIN32 OR WIN64)
 	ADD_EXECUTABLE(bin2res buildtools/bin2res.cpp)
-	GET_TARGET_PROPERTY(BIN2RES bin2res LOCATION)
+	SET(BIN2RES "$<TARGET_FILE:bin2res>")
 ENDIF(WIN32 OR WIN64)
 
 # we somehow have to make LMMS-binary depend on MOC-files
