#!/bin/sh
# Showtime is a Python 3 + GTK 4 application. The core26 base has no
# /usr/bin/python3, and the interpreter that built Showtime lives in the SDK,
# which is not installed on user systems; run the launcher with the interpreter
# from the GNOME platform snap that the gnome extension mounts at
# $SNAP/gnome-platform (the same Python 3.14 that built the snap).
#
# The showtime module tree is at $SNAP/usr/lib/python3/dist-packages, which the
# app's PYTHONPATH in snapcraft.yaml points at.
exec "$SNAP/gnome-platform/usr/bin/python3" "$SNAP/usr/bin/showtime" "$@"
