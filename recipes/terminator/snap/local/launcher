#!/bin/sh
# Terminator is a Python 3 + GTK 3 + VTE application. The GNOME platform snap
# provides the Python interpreter, PyGObject, pycairo, dbus-python and the
# GTK 3/VTE introspection data; psutil and configobj are staged inside this
# snap.
export PYTHONPATH="$SNAP/usr/lib/python3/dist-packages${PYTHONPATH:+:$PYTHONPATH}"

exec "$SNAP/gnome-platform/usr/bin/python3" "$SNAP/usr/bin/terminator" "$@"
