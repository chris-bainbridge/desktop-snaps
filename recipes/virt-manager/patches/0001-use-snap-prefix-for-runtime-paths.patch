     def _set_paths_by_prefix(self, prefix):
+        # In a snap the application is installed under $SNAP/usr while the
+        # compile-time prefix is /usr; the snap revision directory is only
+        # known at run time.
+        if os.environ.get("SNAP"):
+            prefix = os.path.join(os.environ["SNAP"], "usr")
         self.prefix = prefix
         self.gettext_dir = os.path.join(prefix, "share", "locale")
 
