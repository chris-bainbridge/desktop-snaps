# The base snap's /etc/ssh/ssh_config and /etc/ssh/ssh_known_hosts are not
# readable inside a strictly confined snap. The ssh wrapper in this snap
# selects this file with -F, which also makes ssh ignore the unreadable global
# files. Per-user settings from the snap's private home are still read.
GlobalKnownHostsFile /dev/null
# The host's ssh-agent socket is outside the snap's confinement. Keys copied
# to $HOME/.ssh are used directly instead.
IdentityAgent none
# $HOME is the snap's private home ($SNAP_USER_DATA, writable and readable).
# A bare ~ here would be expanded from the passwd entry to the real home
# directory, which the home interface does not expose, so the include would
# silently do nothing.
Include ${HOME}/.ssh/config
# OpenSSH also expands ~ inside the included file from the passwd entry. Use
# absolute paths under /home/<user>/snap/virt-manager/current/.ssh there for
# non-default key names.
