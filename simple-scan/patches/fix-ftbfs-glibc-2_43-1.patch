 			    char *jobUri = (char *)xmlNodeGetContent(node);
-			    char *job = strrchr((const char *)jobUri, '/');
+			    char *job = strrchr(jobUri, '/');
 			    char *scanj = NULL;
 			    if (job != NULL) {
 			        if (strstr(jobUri,"ScanJobs"))
diff --git a/backend/fujitsu.c b/backend/fujitsu.c
index 1b5adc5c4..64eb90f22 100644
--- a/backend/fujitsu.c
+++ b/backend/fujitsu.c
@@ -998,7 +998,7 @@ attach_one (const char *device_name, int connType)
