#!/bin/sh
# Launcher for the strictly confined Stellarium snap.
#
# Stellarium and Qt were built with the usual /usr prefix, but inside the snap
# /usr is the core26 base. Point Qt's plugin lookup, the staged libraries and
# Stellarium's data lookup at $SNAP before exec'ing the binary.
set -eu

case "${SNAP_ARCH:-$(uname -m)}" in
    amd64|x86_64) triplet=x86_64-linux-gnu ;;
    arm64|aarch64) triplet=aarch64-linux-gnu ;;
    *) triplet="$(uname -m)-linux-gnu" ;;
esac

plugins="$SNAP/usr/lib/$triplet/qt6/plugins"
export QT_PLUGIN_PATH="$plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
export QT_QPA_PLATFORM_PLUGIN_PATH="$plugins/platforms"

# snapd puts only $SNAP/lib (and the host's GL dispatch libraries) on
# LD_LIBRARY_PATH. Add the staged Qt, FFmpeg, INDI, Exiv2 and fontconfig
# libraries, keeping the entries the gpu-2604 command chain prepared for Mesa.
export LD_LIBRARY_PATH="$SNAP/usr/lib/$triplet:$SNAP/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Core Desktop is Wayland-first. Prefer the staged Wayland plugin and fall
# back to xcb on an X11 session or when no compositor is reachable.
if [ -z "${QT_QPA_PLATFORM:-}" ]; then
    export QT_QPA_PLATFORM="wayland;xcb"
fi

# Qt looks up icons, desktop files, MIME data and its own translations through
# the XDG data directories; the base does not include $SNAP/usr/share. Keep
# the entries the gpu wrapper has already added (Mesa's drirc and Vulkan data).
export XDG_DATA_DIRS="$SNAP/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Stellarium locates its read-only data through INSTALL_DATADIR, which is
# /usr/share/stellarium and therefore the base inside the snap, with
# <bindir>/../share/stellarium as the fallback. Set the documented override so
# the lookup does not depend on that fallback; users can still point it at
# another tree.
export STELLARIUM_DATA_ROOT="${STELLARIUM_DATA_ROOT:-$SNAP/usr/share/stellarium}"

exec "$SNAP/usr/bin/stellarium" "$@"
